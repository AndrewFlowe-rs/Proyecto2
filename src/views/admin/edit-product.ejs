<!DOCTYPE html>
<html lang="en">
    <%-include("../partials/head")%>
<body>

    <%-include("../partials/header")%>
    <main class="main-forme">

        <form class="form-edit" method="POST" action="/admin/edit/<%= p.id %>?_method=PUT">
            <div class="conteiner-x-edit">
                <a href="/"><i class="fa-solid fa-xmark"></i></a>
            </div>
            <div>
                <h1 class="titulo">Editar producto</h1>
            </div>
            <div class="edit-title">
                <input type="text" id="title" name="titulo" placeholder="Editar nombre" value="<%= p.name %>">
            </div>
            <div class="edit-price">
                <input type="text" id="price" name="precio" placeholder="Editar precio" value="<%= p.price %>">
            </div>
            <div class="edit-description">
                <input type="text" id="description" name="descripcion" placeholder="Editar descripción" value="<%= p.description %>">
            </div>
            <div class="edit-category">
                <label for="category">Categoría actual</label>
                <select name="category" id="category">
                    <option value="Sin TACC"><%= p.categoryName %></option>
                    <option value="Empanadas">Empanadas</option>
                    <option value="Fainá">Fainá</option>
                    <option value="Calzones">Calzones</option>
                    <option value="Clásicas">Clásicas</option>
                    <option value="Pizza del mes">Pizza del mes</option>
                    <option value="peperoni">Promo del mes</option>
                    <option value="Promo del mes">Combos</option>
                    <option value="Individuales">Individuales</option>
                    <option value="Bebidas">Bebidas</option>
                  
                </select>
            </div>
            <div>  
                 <img src="/design/imgProducts/<%= p.image %>" alt="Imagen de pizza" ></div>
          
            <div class="edit-image">
                <label class="label-titulo" for="image">Editar imagen del producto</label>
                <br>
                <input type="file" id="image" name="imagen">
            </div>
            <div class="button">
                <button type="submit" id="button" name="boton">Guardar cambios</button>
            </div>
        </form>

    </main>
    <%-include("../partials/footer")%>
</body>
<!-- <%-include("../partials/dashboard")%> -->

</html>