<!DOCTYPE html>
<html lang="en">
    <%-include("../partials/head",{title: 'Crear producto'})%>
<body>
    <%-include("../partials/header")%>
    <%- include('../partials/burguer') %>

    <main class="main-form-n">
       
        <form class="form-new" method="post" action="/admin/crear-producto" enctype="multipart/form-data" id="productForm">
            <div class="new-contentx">
                <a href="/"><i class="fa-solid fa-xmark"></i></a>
            </div>
            <div>
                <h1 class="titulo">Crear producto</h1>
            </div>
            <div class="new-title">
                <input type="text" id="name" name="name" placeholder="Nuevo titulo">
                <p class="text-danger msg-err" id="nameError"></p>
            </div>
            <div class="new-price">
                <input type="text" id="price" name="price" placeholder="Nuevo precio">
                <p class="text-danger msg-err" id="priceError"></p>
            </div>
            <div class="new-description">
                <input type="text" id="description" name="description" placeholder="Nueva descripcion">
                <p class="text-danger msg-err" id="descriptionError"></p>
            </div>
            <div class="new-category">
                <label for="category">Categoría</label>
                <select name="categoryName" id="category">
                    <option value="">Seleccione una categoría</option>
                    <option value="Sin TACC">Sin TACC</option>
                    <option value="Empanadas">Empanadas</option>
                    <option value="Fainá">Fainá</option>
                    <option value="Calzones">Calzones</option>
                    <option value="Clásicas">Clásicas</option>
                    <option value="Pizza del mes">Pizza del mes</option>
                    <option value="Promo del mes">Promo del mes</option>
                    <option value="Combos">Combos</option>
                    <option value="Individuales">Individuales</option>
                    <option value="Bebidas">Bebidas</option>
                </select>
                <p class="text-danger msg-err" id="categoryError"></p>
            </div>
            <div class="new-image">
                <label class="label-titulo" for="image">Ingresa una imagen</label>
                <br>
                <input type="file" id="image" name="image">
                <p class="text-danger msg-err" id="imageError"></p>
            </div>
            <div class="button">
                <a href="/admin" class="btn btn-tomato-opacity-80">Cancelar</a>
                <button class="btn btn-warning-opacity-80" type="submit" id="button" name="boton">Guardar cambios</button>
            </div>
        </form>
    
        
        
    </main>
<%-include("../partials/footer")%>

    
<!-- <%-include("../partials/dashboard")%> -->
<script src="../../../js/validations/validationCreateProduct.js"></script> 
</body>
</html>