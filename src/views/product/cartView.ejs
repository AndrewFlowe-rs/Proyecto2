<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

<body>


   <!-- Header -->
<%- include('../partials/header') %>


    <main>
    
     <nav class="nav-bar">
             <ul class="list-bar">
                 <li><a href="/carrito/calzones">Clásicas</a></li> 
                 <li><a href="/carrito/Pizza%20del%20mes">Pizzas del mes</a></li>
                 <li class="list-none"><a href="/carrito/promo%20del%20mes">Promo del mes</a></li>
                 <li class="list-none"><a href="/carrito/combos">Combos</a></li>
                 <li class="list-none"><a href="/carrito/individuales">Individuales</a></li>
                 <li class="drinks"><a href="/carrito/bebidas">Bebidas</a></li>
     
                
             </ul>
       </nav>

 
<div class="container-cart-product">
  <% products.forEach(p => {%>
     
         <div class="first-div">
         <div class="contenedor-img">
             <img src="/design/imgProducts/<%= p.image %>" alt="">
         </div>
         <div class="contenedor-descrip">
             <p class="name-pizza"><%= p.name %></p>
     <p class="description"><%= p.description %></p>
     <div class="container-butoms">
     <p class="price"><%= p.price %></p>
  <a href="/detalle/<%= p.id %>" class="btn btn-danger">Ver más</a>    
     </div>
    
     </div>
     </div>
  <%  }); %> 
</div>
 
 
 
 
  
   

     
         </main>

   <!-- Footer -->
<%- include('../partials/footer') %>

</body>

</html>