<!DOCTYPE html>
<html lang="es">
    <!-- Head -->
    <%- include('../partials/head',{title: 'Carrito'}) %>

    <!-- Header -->
   <%- include('../partials/header') %>
    <%- include('../partials/burguer') %>
    <main class="main-cart">
      <div class="article-cart" data-aos="flip-left">
          <article class="articulo-producto-cart">
              <img src="/design/imgProducts/<%= p.image %>" alt="Imagen de pizza">
              <div class=""><h3><%= p.name %></h3>
              <p class="ingredientes"><%= p.description %></p>
              <br>
              <p class="ingredientes">Categoría: <%=p.categoryName%></p>
             
              <hr>
              <p class="totale"><%= toThousand(p.price) %></p> <p class="subtotal">Unidad:</p>
              <hr>  <p class="quantity">1</p>
              <p class="total">Total: <span class="total">0</span></
              </div>

              <div class="quantity-controls">
                  <button class="decrement-quantity">-</button>
                  <button class="increment-quantity">+</button>
                  
              </div>
            
              
              <br>
              <form action="" method="post">
                  <div class="confirmacion">
                      <button class="botonno" type="button">Cancelar</button>
                      <button href="/carrito/agregar/<%= p.id %>" class="botonok" type="submit">Confirmar</button>
                  </div>
              </form>
          </article>
      </div>
  </main>
    <!-- AOS -->
   
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init();</script>
    <!-- Footer -->
    <%- include('../partials/footer') %>
    <script src="../../../js/butDetail.js"></script> 
    <script src="../../../js/addToCart.js"></script> 

         
   </body>
</html>
