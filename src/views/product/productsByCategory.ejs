<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

<body>


   <!-- Header -->
<%- include('../partials/header') %>


    <main class="main-cart">
    
     <nav class="nav-bar">
             <ul class="list-bar">
              <li><a href="/productos/categoria/clásicas">Clásicas</a></li> 
              <li><a href="/productos/categoria/Pizzas%20del%20mes">Pizzas del mes</a></li>
              <li class="list-none"><a href="/productos/categoria/promo%20del%20mes">Promo del mes</a></li>
              <li class="list-none"><a href="/productos/categoria/combos">Combos</a></li>
              <li class="list-none"><a href="/productos/categoria/individuales">Individuales</a></li>
              <li class="drinks"><a href="/productos/categoria/bebidas">Bebidas</a></li>
              
                
             </ul>
       </nav>
  <!-- TÍTULOS -->
  <div class="titles-category"> 
    <h2><%= category %></h2>
  <p class="caption"><%= category%></p>
 </div>
 
 <div class="container-cart-product">
  <% products.forEach(p => {%>
     
         <div class="first-div"data-aos="zoom-out-up">
         <div class="contenedor-img">
             <img src="/design/imgProducts/<%= p.image %>" alt="">
         </div>
         <div class="contenedor-descrip">
             <p class="name-pizza"><%= p.name %></p>
     <p class="description"><%= p.description %></p>
     <div class="container-butoms">
     <p class="price"><%= (p.price) %></p>
  <a href="/detalle/<%= p.id %>" class="btn btn-danger">Ver más</a>   
  <a class="cart-b" href="/carrito/agregar/<%= p.id %>">Agregar<i class="fa-solid fa-cart-shopping"></i></a>   

     </div>
    
     </div>
     </div>
  <%  }); %> 
    </div>
 
 
         </main>
 <!-- AOS -->
 <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
 <script>
  AOS.init();
</script>
   <!-- Footer -->
<%- include('../partials/footer') %>

</body>

</html>
