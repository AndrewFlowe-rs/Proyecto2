<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

<body>


   <!-- Header -->
<%- include('../partials/header') %>
<%- include('../partials/burguer') %>


    <main class="main-cart">
      <div id="carouselExample" class="carousel slide">
         <div class="carousel-inner">
             <div class="carousel-item active">
                 <ul class="list-inline">
                     <li class="list-inline-item"><a href="/productos/categoria/clásicas">Clásicas</a></li>
                     <li class="list-inline-item"><a href="/productos/categoria/Pizza%20del%20mes">Pizzas del mes</a></li>
                     <li class="list-inline-item"><a href="/productos/categoria/promo%20del%20mes">Promo del mes</a></li>
                 </ul>
             </div>
             <div class="carousel-item">
                 <ul class="list-inline">
                     <li class="list-inline-item"><a href="/productos/categoria/combos">Combos</a></li>
                     <li class="list-inline-item"><a href="/productos/categoria/individuales">Individuales</a></li>
                     <li class="list-inline-item"><a href="/productos/categoria/fainá">Fainá</a></li>
                 </ul>
             </div>
             <div class="carousel-item">
                 <ul class="list-inline">
                     <li class="list-inline-item"><a href="/productos/categoria/Sin%20tacc">Sin TACC</a></li>
                     <li class="list-inline-item"><a href="/productos/categoria/calzones">Calzones</a></li>
                     <li class="list-inline-item"><a href="/productos/categoria/Empanadas">Empanadas</a></li>
                 </ul>
             </div>
             <div class="carousel-item">
                 <ul class="list-inline">
                     <li class="list-inline-item"><a href="/productos/categoria/bebidas">Bebidas</a></li>
                 </ul>
             </div>
         </div>
         <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
             <span class="carousel-control-prev-icon" aria-hidden="true"></span>
             <span class="visually-hidden">Previous</span>
         </button>
         <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
             <span class="carousel-control-next-icon" aria-hidden="true"></span>
             <span class="visually-hidden">Next</span>
         </button>
     </div>
  <!-- TÍTULOS -->
  <div class="titles-category"> 
    <h2><%= category %></h2>
  <p class="caption"><%= category%></p>
 </div>
 
 <div class="container-cart-product">
  <% products.forEach(p => {%>
     
         <div class="first-div"data-aos="zoom-out-up">
         <div class="contenedor-img">
             <img src="/design/imgProducts/<%= p.image %>" alt="">
         </div>
         <div class="contenedor-descrip">
             <p class="name-pizza"><%= p.name %></p>
     <p class="description"><%= p.description %></p>
     <div class="container-butoms">
     <p class="price"><%= (p.price) %></p>
  <a href="/detalle/<%= p.id %>" class="btn btn-danger">Ver más</a>   
  <a class="cart-b" href="/carrito/agregar/<%= p.id %>">Agregar<i class="fa-solid fa-cart-shopping"></i></a>   

     </div>
    
     </div>
     </div>
  <%  }); %> 
    </div>
 
 
         </main>
            <!-- Bootstrap scrip -->

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>
 <!-- AOS -->
 <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
 <script>
  AOS.init();
</script>
   <!-- Footer -->
<%- include('../partials/footer') %>

</body>

</html>
