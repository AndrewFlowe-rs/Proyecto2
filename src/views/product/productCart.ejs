<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

<body>


   <!-- Header -->
<%- include('../partials/header') %>


    <main>
    
     <nav class="nav-bar">
             <ul class="list-bar">
                 <li><a href="">Clásicas</a></li> 
                 <li><a href="#Pizzasdelmes">Pizzas del mes</a></li>
                 <li class="list-none"><a href="#promodelmes">Promo del mes</a></li>
                 <li class="list-none"><a href="#combos">Combos</a></li>
                 <li class="list-none"><a href="#individuales">Individuales</a></li>
                 <li class="drinks"><a href="#bebidas">Bebidas</a></li>
     
                
             </ul>
       </nav>
  <!-- TÍTULOS -->
  <div class="titles-category"> 
    <h2><%= category %></h2>
  <p class="caption"><%= category %></p>
 </div>
 
 
  <% products.forEach(p => {%>
     
         <div class="first-div">
         <div class="contenedor-img">
             <img src="/design/imgProducts/<%= p.image %>" alt="">
         </div>
         <div class="contenedor-descrip">
             <p class="name-pizza"><%= p.name %></p>
     <p class="description"><%= p.description %></p>
     <div class="container-butoms">
     <p class="price"><%= p.price %></p>
  <a href="/detalle/<%= p.id %>" class="btn btn-danger">Ver más</a>    
     </div>
    
     </div>
     </div>
  <%  }); %> 

 
 
 
 
  
   

     
         </main>

   <!-- Footer -->
<%- include('../partials/footer') %>

</body>

</html>
