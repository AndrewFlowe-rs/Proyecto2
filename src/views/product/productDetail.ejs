<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>
<body>


     <!-- Header -->
<%- include('../partials/header') %>




 <main class="main-product">
        <div class="article">
        
            <article class="articulo-producto">

                <img src="/design/imgProducts/<%= p.image %>" alt="Imagen de pizza">

                <h3><%= p.name %></h3>

                <p class="ingredientes"><%= p.description %></p>
                <hr>
                <P class="subtotal">Subtotal</P>
                <hr>
                <p class="total"><%= p.price %></p>

                <div class="confirmacion">

                    <button class="botonno" type="button">Cancelar<i class="fa-solid fa-xmark"></i>
                    </button>

                    <button class="botonok" type="button">Agregar<i class="fa-solid fa-check"></i>
                    </button>

                    
                </div>
            </article>

        </div>



    </main>

    


   <!-- Footer -->
   <%- include('../partials/footer') %>

   
</body>

</html>