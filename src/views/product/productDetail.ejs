<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>
<body>


     <!-- Header -->
<%- include('../partials/header') %>




 <main class="main-product">
    
        <div class="article"  data-aos="flip-left">
        
            <article class="articulo-producto" >
                
                <img src="/design/imgProducts/<%= p.image %>" alt="Imagen de pizza" >

                <h3><%= p.name %></h3>

                <p class="ingredientes"><%= p.description %></p>
                <hr>
                <P class="subtotal">Subtotal</P>
                <hr>
                <p class="total"><%= toThousand(p.price) %></p>
                
                <div class="confirmacion">

                    <button class="botonno" type="button">Cancelar<i class="fa-solid fa-xmark"></i>
                    </button>

                    <a href="/carrito/agregar/<%= p.id %>" class="botonok" type="button">Agregar<i class="fa-solid fa-check"></i>
                   

                </div>
            </article>

        </div>


    </main>

    
 <!-- AOS -->
 <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
 <script>
  AOS.init();
</script>


   <!-- Footer -->
   <%- include('../partials/footer') %>
   <script src="../../../js/butDetail.js"></script> 


   
</body>

</html>