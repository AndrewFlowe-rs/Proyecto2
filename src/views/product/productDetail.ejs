<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head' ,{title: p.name}) %>
<body>


     <!-- Header -->
<%- include('../partials/header') %>
<%- include('../partials/burguer') %>





 <main class="main-product">
    
        <div class="article"  data-aos="flip-left">
        
            <article class="articulo-producto" >
                
                <img src="/design/imgProducts/<%= p.image %>" alt="Imagen de pizza" >

                <h3><%= p.name %></h3>
                

                <p class="ingredientes"><%= p.description %></p>
                <p class="ingredientes">Categoría:</p>
                <p class="ingredientes"><%=p.categoryName%></p>
                <hr>
                <P class="subtotal">Subtotal</P>
                <hr>
                <p class="total"><%= toThousand(p.price) %></p>
                
                <div class="confirmacion">

                    <button class="botonno" type="button">Cancelar
                    </button>

                    <a href="/carrito" class="botonok" type="button">Agregar al carrito
                   

                </div>
            </article>

        </div>


    </main>

    
 <!-- AOS -->
 <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
 <script>
  AOS.init();
</script>
   <!-- Footer -->
   <%- include('../partials/footer') %>
   <script src="../../../js/butDetail.js"></script> 


   
</body>

</html>