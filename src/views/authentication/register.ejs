<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

    <body>


        <!-- Header -->
        <%- include('../partials/header') %>

            <main class="main-register">

                <form class="form-register" action="/aut/registro" method="POST" enctype="multipart/form-data">
                    <div class="conteiner-x">
                        <a href="/"><i class="fa-solid fa-xmark"></i></a>
                    </div>
                    <div class="conteiner-t-r">
                        <h4>CREA TU CUENTA</h4>
                    </div>
                    <div class="conteiner-form">
                        <div>  <!-- Campo nombre -->
                             <input type="text" placeholder="Nombre" id="nombre" name="name"
                            value="<%= locals.old && locals.old.name ? locals.old.name : '' %>">
                           
                            <% if (locals.errors) { %>
                                <div class="form-text fs-5 text-danger">
                                    <%= errors?.name?.msg %>
                                </div>    <% } %>
                          
                        </div>
                        <div>
                             <!-- Campo email --> 
                              <input type="text" placeholder="Email" id="email" name="email"
                              value="<%= locals.old && locals.old.email ? locals.old.email : '' %>">
                            <% if (locals.errors) { %>
                                <div class="form-text fs-5 text-danger">
                                    <%= errors?.email?.msg %>
                                </div> <% } %>
                           
                        </div>

                                 <!-- Campo contraseña -->
                        <div> 
                            <input type="password" placeholder="contraseña" id="password" name="password"
                            value="<%= locals.old && locals.old.password ? locals.old.password : '' %>">
                            <% if (locals.errors) { %>
                                <div class="form-text fs-5 text-danger">
                                    <%= errors?.password?.msg %>
                                </div> <% } %>
                           
                        </div>
                                  <!-- Campo número-teléfono -->
                        <div>
                            <input type="number" placeholder="Numero de Tel." id="num" name="number"
                            value="<%= locals.old && locals.old.number ? locals.old.number : '' %>">
                            <% if (locals.errors) { %>
                                <div class="form-text fs-5 text-danger">
                                    <%= errors?.number?.msg %>
                                </div>     <% } %>
                            
                        </div>
                         <!-- Campo ciudad -->
                        <div>  
                            <input type="text" placeholder="ciudad" id="direction" name="city"
                            value="<%= locals.old && locals.old.city ? locals.old.city : '' %>">
                            <% if (locals.errors) { %>
                                <div class="form-text fs-5 text-danger">
                                    <%= errors?.city?.msg %>
                                </div>   <% } %>
                          
                        </div>
                         <!-- Campo imagen de perfil -->
                       
                        <div class="archivos">
                            <input type="file" placeholder="avatar" id="avatar" name="avatar">
                           
                     
                             <% if (locals.errors) { %>
                            <p>  <%= locals.errors.msg %></p>     <% } %>
                        </div>
                    </div>


                    <div class="container-butons">

                        <button type="submit">Crear Cuenta</button>

                    </div>
                    <div class="c-register">
                        <h3>¿ya tienes una cuenta?/</h3><a href="/aut/login">Ingresa</a>
                    </div>
                </form>



            </main>


            <!-- Footer -->
            <%- include('../partials/footer') %>
    </body>

</html>