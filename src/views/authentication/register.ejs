<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

    <body>


        <!-- Header -->
        <%- include('../partials/header') %>
            <main class="main-register">

                <form class="form-register" action="/aut/registro" method="POST" enctype="multipart/form-data">
                <div class="conteiner-x">
                    <a href="/"><i class="fa-solid fa-xmark"></i></a>
                </div>
                <div class="conteiner-t-r">
                    <h4>CREA TU CUENTA</h4>
                </div>
                <div class="conteiner-form">
                    <div> <!-- Campo nombre -->
                        <input class="name" type="text" placeholder="Nombre" id="nombre" name="name" value="<%= locals.old && locals.old.name ? locals.old.name : '' %>">
                        <p class=" text-danger msg-err"></p>
                        <div class="error-msg <%= locals.errors && locals.errors.name ? 'visible' : 'hidden' %>">
                            <%= locals.errors?.name?.msg %>
                        </div>
                       


                    </div>

                    <div>
                         <!-- Campo email -->
                          <input type="text" placeholder="Email" id="email" name="email" value="<%= locals.old && locals.old.email ? locals.old.email : '' %>">
                          <p class=" text-danger msge-err"></p>

                          <div class="error-msg <%= locals.errors && locals.errors.email ? 'visible' : 'hidden' %>">

                            <%= locals.errors?.email?.msg %>
                        </div>


                    </div>

                             <!-- Campo contraseña -->
                    <div>
                        <input type="password" placeholder="contraseña" id="password" name="password"  value="<%= locals.old && locals.old.password ? locals.old.password : '' %>">
                        <p class=" text-danger err-p"></p>

                        <div class="error-msg <%=locals.errors && locals.errors.password ? 'visible' : 'hidden' %>">
                            <%= locals.errors?.password?.msg %>
                        </div>

                    </div>
                              <!-- Campo número-teléfono -->
                    <div>
                        <input type="number" placeholder="Numero de Tel." id="num" name="number" value="<%= locals.old && locals.old.number ? locals.old.number : '' %>">
                        <p class=" text-danger err-n"></p>
                            <div class="error-msg <%=locals.errors && locals.errors.number ? 'visible' : 'hidden' %>">

                                <%= locals.errors?.number?.msg %>
                        </div>

                    </div>
                     <!-- Campo ciudad -->
                    <div>
                        <input type="text" placeholder="ciudad" id="direction" name="city" value="<%= locals.old && locals.old.city ? locals.old.city : '' %>">
                        <p class=" text-danger err-c"></p>
                            <div class="error-msg <%=locals.errors && locals.errors.city ? 'visible' : 'hidden' %>">
                                <%= locals.errors?.city?.msg %>
                      </div>
                    </div>
                    <div class="new-image">
                        <label class="label-titulo" for="image">Ingresa una imagen</label>
                        <br>
                        <input type="file" id="image" name="avatar">
                        <p class="text-danger msg-err" id="imageError"></p>
                    </div>
                   

                </div>


                <div class="container-butons">

                    <button type="submit">Crear Cuenta</button>

                </div>
                <div class="c-register">
                    <h3>¿ya tienes una cuenta?/</h3><a href="/aut/login">Ingresa</a>
                </div>
            </form>



        </main>


            <!-- Footer -->
            <%- include('../partials/footer') %>
             <script src="../../../js/validations/validationRegister.js"></script> 

        </body>
</html>