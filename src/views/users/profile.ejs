<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head',{title: `Perfil de ${user.name}` }) %>
<body>
  <%- include('../partials/header') %>
  <%- include('../partials/burguer') %>

  <main class="main-profile">
    
    <p class="title-profile">Hola <br><%= user.name %>, este es tu perfil </p>
    
    <form class="form-profile" action="/perfil" method="GET" enctype="multipart/form-data">
        <div class="user-img"> <img class="user-im" src="/design/users/<%=user.avatar %>" alt="" id="avatar">
      </div>
      <div class="">
        <label for="name" class="col-sm-2 col-form-label">Nombre:</label>
        <div class="col-sm-10">
          <input type="text" readonly class="form-control-plaintext" id="name" value="<%= user.name %>">
        </div>
      </div>
      <div class="">
        <label for="email" class="col-sm-2 col-form-label">Email:</label>
        <div class="col-sm-10">
          <input type="text" readonly class="form-control-plaintext" id="email" value="<%= user.email %>">
        </div>
      </div>
      <div class="">
        <label for="state" class="col-sm-2 col-form-label">Provincia:</label>
        <div class="col-sm-10">
          <input type="text" readonly class="form-control-plaintext" id="state" value="<%= user.state %>">
        </div>
      </div>
      <div class="">
        <label for="number" class="col-sm-2 col-form-label">Número:</label>
        <div class="col-sm-10">
          <input type="text" readonly class="form-control-plaintext" id="number" value="<%= user.number %>">
        </div>
      </div>

<a class="btn btn-danger" href="/aut/logout">Salir</a>
<a class="btn btn-danger" href="http://localhost:5173">Administración</a>

<!-- <a class="btn btn-danger" href="/perfil/editar/<%=user.id %>">Editar perfil</a> -->

    </form>

    
      
  </main>
  <%- include('../partials/footer') %>


</body>
</html>
