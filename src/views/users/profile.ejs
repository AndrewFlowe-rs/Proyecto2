<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="main-profile">
    
    <p class="title-profile">Hola <br><%= user.name %>, este es tu perfil</p>
    <form class="form-profile" action="/perfil" method="POST" enctype="multipart/form-data">
      <div class="user-img"> <img src="/design/users/<%=user.avatar %>" alt="">
      </div>
      <div class="">
        <label for="name" class="col-sm-2 col-form-label">Nombre:</label>
        <div class="col-sm-10">
          <input type="text" readonly class="form-control-plaintext" id="name" value="<%= user.name %>">
        </div>
      </div>
      <div class="">
        <label for="email" class="col-sm-2 col-form-label">Email:</label>
        <div class="col-sm-10">
          <input type="text" readonly class="form-control-plaintext" id="email" value="<%= user.email %>">
        </div>
      </div>
      <div class="">
        <label for="email" class="col-sm-2 col-form-label">Número:</label>
        <div class="col-sm-10">
          <input type="text" readonly class="form-control-plaintext" id="email" value="<%= user.number %>">
        </div>
      </div>
    </form>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
