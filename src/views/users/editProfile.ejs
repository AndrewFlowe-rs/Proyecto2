<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <%- include('../partials/burguer') %>

  <main class="main-profile">
    
    <p class="title-profile">Hola <br><%= user.name %>, este es tu perfil</p>
    
    <form class="form-profile" action="/perfil/editar/<%=user.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
      <div class="user-img"> <img class="user-im" src="/design/users/<%=user.avatar %>" alt="">
      </div>
      <div class="">
        <label for="name" class="col-sm-2 col-form-label">Nombre:</label>
        <div class="col-sm-10">
          <input type="text"  id="name" value="<%= user.name %>">
        </div>
      </div>
      <div class="">
        <label for="email" class="col-sm-2 col-form-label">Email:</label>
        <div class="col-sm-10">
          <input type="text"  id="email" value="<%= user.email %>">
        </div>
      </div>
      <div class="">
        <label for="email" class="col-sm-2 col-form-label">Provincia:</label>
        <div class="col-sm-10">
          <input type="text"  id="state" value="<%= user.state %>">
        </div>
      </div>
      <div class="">
        <label for="number" class="col-sm-2 col-form-label">Número:</label>
        <div class="col-sm-10">
          <input type="text"  id="number" value="<%= user.number %>">
        </div>
      </div>
      <button class="but-out">Cerrar Sesión</button> 
      <button type="submit">Actualizar</button>
    </form>
    
      
      
  </main>
  <%- include('../partials/footer') %>
  <script src="../../../js/buttonLogout.js"></script> 

</body>
</html>
