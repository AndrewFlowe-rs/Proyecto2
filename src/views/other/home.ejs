<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

  <body>


    <!-- Header -->
    <%- include('../partials/header') %>

      <main>

          <div class="div-padre">

            <div id="carouselExample" class="carousel slide">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/design/imgProducts/logo-home.jpg" class="d-block w-100" alt="...">
                </div>
                <div class="carousel-item">
                  <img src="/design/imgProducts/logo-home.jpg" class="d-block w-100" alt="...">
                </div>
                <div class="carousel-item">
                  <img src="/design/imgProducts/logo-home.jpg" class="d-block w-100" alt="...">
                </div>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>

            <div class="home-div">
            <div class="div-categorias">

              <h1>CATEGORIAS</h1>

              <div class="bannerhome">
                <ul>
                  <li><a href="#">Pizzas</a></li>
                  <li><a href="#">Calzones</a></li>
                  <li><a href="#">Faina</a></li>
                  <li><a href="#">Canasta</a></li>
                  <li><a href="#">Empanadas</a></li>
                  <li><a href="#">Sin TACC</a></li>
                  <li><a href="#">Clásicas</a></li>
                  <li><a href="#">Pizzas del mes</a></li>
                  <li><a href="#">Promo del mes</a></li>
                  <li><a href="#">Combos</a></li>
                  <li><a href="#">Individuales</a></li>
                  <li><a href="#">Bebidas</a></li>
                </ul>
              </div>
              <div class="anuncios-img">
                <img src="/design/imgProducts/CANA-008-380x2851.jpg" alt="Imagen de empanada canastita">
                <img src="/design/imgProducts/empanadas.jpg" alt="Empanadas">
                <img src="/design/imgProducts/qr.jpg" alt="QR">
              </div>
              </div>

              <% products.forEach(p => { %>
                <% if (p.category === 'Promo del mes') { %>
             <div class="container-product">
              <section class="pizzasinferior">
                        <article class="pizza-cala">
                            <img src="/design/imgProducts/<%= p.image %>" alt="">
                            <div class="descripcion-producto">
                                <h3><%= p.name %></h3>
                                <ul>
                                    <p><%= p.description %></p>
                                </ul>
                                <a href="/detalle/<%= p.id %>" class="btn btn-danger">Ver más</a>
                            </div>
                        </article>
                    </section> 
                  </div>
              </div>
                
                 
                <% } %>
            <% }) %>
            
             
 

   
          

          
        </div>

        </div>
        </div>
      </div>
      </main>


      <!-- Footer -->
      <%- include('../partials/footer') %>
  </body>

</html>