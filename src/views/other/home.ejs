<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

  <body>


    <!-- Header -->
    <%- include('../partials/header') %>

      <main class="main-home">
          <div class="div-padre">

            <div id="carouselExampleSlidesonly" class="carousel slide" data-bs-ride="carousel"  data-bs-interval="4000">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/design/imgProducts/logo-home.jpg"   class="d-block w-10" alt="...">
                </div>
                <div class="carousel-item">
                  <img src="/design/imgProducts/xqwJySBdj_930x525__1.jpg"class="d-block w-10" alt="...">
                </div>
                <div class="carousel-item">
                  <img src="/design/imgProducts/pizza-diavola.jpg" class="d-block w-10" alt="...">
                </div>
                <div class="carousel-item active">
                  <img src="/design/imgProducts/banner2.jpg"   class="d-block w-10" alt="...">
                </div>
              </div>
            </div>

            <div class="home-div">
            <div class="div-categorias">

              <h1>CATEGORIAS</h1>

              <div class="bannerhome">
                <ul>
                  <li><a href="/carrito/calzones">Calzones</a></li>
                  <li><a href="/carrito/fainá">Fainá</a></li>
                  <li><a href="/carrito/Empanadas">Empanadas</a></li>
                  <li><a href="/carrito/Sin%20tacc">Sin TACC</a></li>
                  <li><a href="/carrito/clásicas">Clásicas</a></li>
                  <li><a href="/carrito/Pizza%20del%20mes">Pizzas del mes</a></li>
                  <li><a href="/carrito/promo%20del%20mes">Promo del mes</a></li>
                  <li><a href="/carrito/combos">Combos</a></li>
                  <li><a href="/carrito/individuales">Individuales</a></li>
                  <li><a href="/carrito/bebidas">Bebidas</a></li>
                </ul>
              </div>
              <div class="anuncios-img">
                <img src="/design/imgProducts/CANA-008-380x2851.jpg" alt="Imagen de empanada canastita">
                <img src="/design/imgProducts/empanadas.jpg" alt="Empanadas">
                <img src="/design/imgProducts/qr.jpg" alt="QR">
              </div>
              </div>

              <% products.forEach(p => { %>
                <% if (p.category === 'Promo del mes') { %>
             <div class="container-product">
              <section class="pizzasinferior">
                        <article class="pizza-cala">
                            <img src="/design/imgProducts/<%= p.image %>" alt="">
                            <div class="descripcion-producto">
                                <h3><%= p.name %></h3>
                                <ul>
                                    <p><%= p.description %></p>
                                </ul>
                                <a href="/detalle/<%= p.id %>" class="btn btn-danger">Ver más</a>
                            </div>
                        </article>
                    </section> 
                  </div>
              </div>
                
                 
                <% } %>
            <% }) %>
   
        </div>

        </div>
        </div>
      </div>
     
      
      </main>


     
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
          integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
          crossorigin="anonymous"></script>
           <!-- Footer -->
      <%- include('../partials/footer') %>
      <!-- Bootstrap scrip -->
  </body>

</html>