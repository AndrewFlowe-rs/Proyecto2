<!DOCTYPE html>
<html lang="es">

<!-- Head -->
<%- include('../partials/head') %>

  <body>


    <!-- Header -->
    <%- include('../partials/header') %>
    <%- include('../partials/burguer') %>

      <main class="main-home">
          <div class="div-padre">

            <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/design/imgProducts/5.jpg"   class="d-block w-10" alt="...">
                </div>
                <div class="carousel-item">
                  <img src="/design/imgProducts/2.jpg" class="d-block w-10" alt="...">
                </div>
                <div class="carousel-item">
                  <img src="/design/imgProducts/3.jpg" class="d-block w-10" alt="...">
                </div>
                <div class="carousel-item">
                  <img src="/design/imgProducts/4.jpg"   class="d-block w-10" alt="...">
                </div>
                <div class="carousel-item">
                  <img src="/design/imgProducts/pizza2.jpg"   class="d-block w-10" alt="...">
                </div>
              </div>
           
             

              <div class="bannerhome"> 
                <ul>
                  <li><a href="/productos/categoria/calzones">Calzones</a></li>
                  <li><a href="/productos/categoria/fainá">Fainá</a></li>
                  <li><a href="/productos/categoria/Empanadas">Empanadas</a></li>
                  <li><a href="/productos/categoria/Sin%20tacc">Sin TACC</a></li>
                  <li><a href="/productos/categoria/clásicas">Clásicas</a></li>
                  <li><a href="/productos/categoria/Pizza%20del%20mes">Pizzas del mes</a></li>
                  <li><a href="/productos/categoria/promo%20del%20mes">Promo del mes</a></li>
                  <li><a href="/productos/categoria/combos">Combos</a></li>
                  <li><a href="/productos/categoria/individuales">Individuales</a></li>
                  <li><a href="/productos/categoria/bebidas">Bebidas</a></li>
                </ul>
              </div>
           <div class="container-product">        
              <% products.forEach(p => { %>
                <% if (p.categoryName === 'Promo del mes') { %>
            

              <div class="card" data-aos="zoom-out-up">
                <img src="/design/imgProducts/<%= p.image %>" class="card-img-top" alt="...">
                <div class="card-body">
                  <h5 class="card-title"><%= p.name %></h5>
                  <p class="card-text"><%= p.description %></p>
                  <a href="/detalle/<%= p.id %>" class="btn btn-outline-danger">Ver más</a>
                  <a class="cart-b" href="/carrito/agregar/<%= p.id %>">Agregar<i class="fa-solid fa-cart-shopping"></i></a>   

                </div>
              </div>
                
                 
                <% } %>
            <% }) %>
   
        </div>
     
      
      </main>


           <!-- Bootstrap scrip -->

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
          integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
          crossorigin="anonymous"></script>
           <!-- AOS -->
 <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
 <script>
  AOS.init();
</script>
           <!-- Footer -->
      <%- include('../partials/footer') %>
  </body>

</html>